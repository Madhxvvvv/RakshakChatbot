# Choose your LLM provider: "gemini" or "groq" (default: gemini)
LLM_PROVIDER=gemini

# --- Google Gemini Configuration ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Groq Configuration ---
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- RAG Configuration ---
# Optional: HuggingFace token for model downloads (not required for public models)
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=
EMBEDDING_MODEL=all-MiniLM-L6-v2

TEMPERATURE=0.3
MAX_TOKENS=2048

RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200