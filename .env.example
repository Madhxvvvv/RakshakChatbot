# Choose your LLM provider: "gemini" or "groq".
# If unset, the provider whose API key is set below is used.
LLM_PROVIDER=gemini

# --- Google Gemini Configuration ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Groq Configuration ---
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b

# --- RAG Configuration ---
# Optional: HuggingFace token for model downloads (not required for public models)
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=
EMBEDDING_MODEL=all-MiniLM-L6-v2

TEMPERATURE=0.3
MAX_TOKENS=2048

RAG_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Hybrid retrieval weights (dense embeddings vs. BM25)
RAG_DENSE_WEIGHT=0.7
RAG_BM25_WEIGHT=0.3

# Scope check: refuse when the best embedding similarity is below the floor.
# Questions naming one of the five diseases use the lower NAMED floor.
RAG_SCOPE_THRESHOLD=0.52
RAG_SCOPE_THRESHOLD_NAMED=0.20
